# Dependencias
node_modules/

# Yarn Berry (v2+)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnp.loader.mjs

# Variables de entorno (necesarias para ejecutar el servicio localmente)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs de depuración y ejecución
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Archivos de depuración y runtime
pids
*.pid
*.seed
*.pid.lock

# Cobertura de pruebas (Testing)
coverage/
.nyc_output/

# Archivos de editores e IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos del sistema operativo
.DS_Store
Thumbs.db

